# 服务端口
PORT=8080
# 监听地址，容器内保持 0.0.0.0
HOST=0.0.0.0
# 数据目录（Docker 中挂载到 /data）
DATA_DIR=./data

# 首次启动使用的初始密码（之后以后台设置为准）
FRONT_PASSWORD=123456
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 固定会话签名密钥；留空则自动生成并保存在 data/.secret
# 建议固定（openssl rand -hex 32 生成），否则重建容器会让已登录设备掉线
SESSION_SECRET=

# 通过 HTTPS 反代访问时设为 1，Cookie 会带上 Secure
COOKIE_SECURE=0
